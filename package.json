{
  "name": "sololink",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "deploy": "nuxt build && wrangler deploy",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:migrate:local": "wrangler d1 migrations apply sololink --local",
    "db:migrate:prod": "wrangler d1 migrations apply sololink --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "lucide-vue-next": "^0.577.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "drizzle-kit": "^0.31.11",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "~5.9",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.2"
  }
}
