{
  "name": "sololink",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && npx wrangler deploy",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:migrate:local": "wrangler d1 migrations apply jiugenav --local",
    "db:migrate:prod": "wrangler d1 migrations apply jiugenav --remote"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "drizzle-orm": "^0.30.1",
    "lucide-react": "^0.294.0",
    "next": "latest",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "@opennextjs/cloudflare": "^1.14.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "drizzle-kit": "^0.20.14",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "wrangler": "^4.54.0"
  }
}
